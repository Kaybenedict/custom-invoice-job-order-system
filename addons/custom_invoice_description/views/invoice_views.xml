<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_custom" model="ir.ui.view">
        <field name="name">account.move.form.inherit.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="after">
                <field name="description"/>
                <field name="height"/>
                <field name="width"/>
                <field name="unit"/>
                <field name="number_items"/>
                <field name="total_sq_ft" readonly="1"/>
                <field name="amount_per_sq_ft" readonly="1"/>
                <field name="total_amount_payable" readonly="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_job_order" string="Create Job Order" type="object" class="btn-primary" invisible="move_type != 'out_invoice'"/>
            </xpath>
        </field>
    </record>
</odoo>